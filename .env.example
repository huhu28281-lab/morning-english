# Optional runtime secret for per-visitor Azure keys or legacy Sites AI keys.
# Native Cloudflare AI chat does not need an API token or this encryption key.
APP_ENCRYPTION_KEY=

# Standalone Cloudflare deployment (leave empty for Sites).
CF_D1_DATABASE_ID=

# Set to true in RUNTIME variables only after checking the account is Workers Free.
# Missing value: disabled. Dashboard settings persist across code deployments.
# This does not inspect or change the Cloudflare account plan.
CF_AI_FREE_PLAN_CONFIRMED=
